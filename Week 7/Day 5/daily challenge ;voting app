import { createElement as h, useState } from 'react'

function VotingApp() {
	const [languages, setLanguages] = useState([
		{ name: 'Php', votes: 0 },
		{ name: 'Python', votes: 0 },
		{ name: 'JavaScript', votes: 0 },
		{ name: 'Java', votes: 0 },
	])

	const voteForLanguage = (languageName) => {
		setLanguages((currentLanguages) => currentLanguages.map((language) => (
			language.name === languageName
				? { ...language, votes: language.votes + 1 }
				: language
		)))
	}

	return h('div', { className: 'vote-list' },
		...languages.map((language) => h('div', { className: 'vote-row', key: language.name },
			h('div', { className: 'vote-language' },
				h('h3', null, language.name),
				h('span', { className: 'vote-count' }, `${language.votes} ${language.votes === 1 ? 'vote' : 'votes'}`),
			),
			h('button', {
				className: 'button button-dark vote-button',
				onClick: () => voteForLanguage(language.name),
				type: 'button',
			}, 'Vote'),
		)),
	)
}

export default VotingApp
